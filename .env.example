DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Database
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password-here
DATABASE_HOST=your-project-ref.supabase.co
DATABASE_PORT=6543

# Supabase API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@b2bmarketplace.com

# Firebase Cloud Messaging (push notifications) - OPTIONAL.
# Push stays disabled until one of these is set (in-app notifications work regardless).
# Provide the service-account JSON as a single-line string (best for Render/hosted),
# OR a path to the .json file. Get it from Firebase Console -> Project Settings -> Service accounts.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=
